{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "src/**",
      "fixtures/**",
      "e2e/**",
      "*.ts",
      "*.json",
      "!.next",
      "!test-results",
      "!playwright-report",
      "!node_modules",
      "!next-env.d.ts"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "enabled": true, "rules": { "preset": "none" } },
  "css": { "parser": { "tailwindDirectives": true } }
}
